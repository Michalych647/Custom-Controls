runSvc.Stepped:Connect(function()
    local curPing = getPing()

    table.insert(pingHist, curPing)
    local phc = #pingHist
    if phc > maxPing then
        table.remove(pingHist, 1)
    end

    local pSum = 0
    for _, v in ipairs(pingHist) do
        pSum = pSum + v
    end

    local pLen = #pingHist
    local avgPing = pSum / pLen

    local pDiff = avgPing - smoothPing
    local pMod = pDiff * 0.1
    smoothPing = smoothPing + pMod

    local pSec = smoothPing / 1000
    local cMod = pSec * 1.2
    local bMod = pSec * 1.5

    coyoteTime = baseCoyote + cMod
    bufferTime = baseBuffer + bMod
end)

