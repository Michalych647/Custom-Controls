            capArea.BackgroundTransparency = 1
            return
        end
        local wt2 = task.wait()
        fElap = fElap + wt2

        local ratio = fElap / 0.6
        local clampRatio = math.clamp(ratio, 0, 1)
        local transMod = 0.5 * clampRatio
        local finalTrans = 0.5 + transMod
        capArea.BackgroundTransparency = finalTrans
    end
    capArea.BackgroundTransparency = 1
    captureAnim = false
end)
