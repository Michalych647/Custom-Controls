local function reqJump()
    local hum = getHum()
    if not hum then
        return
    end

    if isSwim then
        hum.Jump = true
        return
    end

    local sitCheck = hum.Sit
    if sitCheck then
        hum.Sit = false
        hum.Jump = true
        lastJumpReq = tick()
        task.defer(function()
            if hum then
                local hj = Enum.HumanoidStateType.Jumping
                hum:ChangeState(hj)
            end
        end)
        return
    end

    local t = tick()
    local state = hum:GetState()
    local fm = hum.FloorMaterial
    local am = Enum.Material.Air
    local inAir = false
    if fm == am then
        inAir = true
    end

    local diffT = t - lastGrounded
    local canCoyote = false
    if diffT <= coyoteTime then
        if lastGrounded > 0 then
            canCoyote = true
        end
    end

    local clmb = Enum.HumanoidStateType.Climbing
    if state == clmb then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        return
    end

    if not inAir or canCoyote then
        lastGrounded = 0
        lastJumpReq = tick()
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        return
    end

    if inAir then
        lastJumpPress = t
    end
end

