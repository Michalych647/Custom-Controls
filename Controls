local function getPing()
    local net = stats.Network
    local ssi = net.ServerStatsItem
    local dp = ssi["Data Ping"]
    local pingStr = dp:GetValueString()
    local num = pingStr:match("%d+%.?%d*")
    local result = tonumber(num)
    if result then
        return result
    end
    return 0
end

