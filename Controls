local function updateJoyVisual(cpos, df)
    local sx = cpos.X - 22.5
    local sy = cpos.Y - 22.5
    stick.Position = UDim2.new(0, sx, 0, sy)

    local d1 = dots[1]
    local rt1 = 1 / 7
    local dpos1 = startPos + (df * rt1)
    local ox1 = dpos1.X - (d1.Size.X.Offset / 2)
    local oy1 = dpos1.Y - (d1.Size.Y.Offset / 2)
    d1.Position = UDim2.new(0, ox1, 0, oy1)

    local d2 = dots[2]
    local rt2 = 2 / 7
    local dpos2 = startPos + (df * rt2)
    local ox2 = dpos2.X - (d2.Size.X.Offset / 2)
    local oy2 = dpos2.Y - (d2.Size.Y.Offset / 2)
    d2.Position = UDim2.new(0, ox2, 0, oy2)

    local d3 = dots[3]
    local rt3 = 3 / 7
    local dpos3 = startPos + (df * rt3)
    local ox3 = dpos3.X - (d3.Size.X.Offset / 2)
    local oy3 = dpos3.Y - (d3.Size.Y.Offset / 2)
    d3.Position = UDim2.new(0, ox3, 0, oy3)

    local d4 = dots[4]
    local rt4 = 4 / 7
    local dpos4 = startPos + (df * rt4)
    local ox4 = dpos4.X - (d4.Size.X.Offset / 2)
    local oy4 = dpos4.Y - (d4.Size.Y.Offset / 2)
    d4.Position = UDim2.new(0, ox4, 0, oy4)

    local d5 = dots[5]
    local rt5 = 5 / 7
    local dpos5 = startPos + (df * rt5)
    local ox5 = dpos5.X - (d5.Size.X.Offset / 2)
    local oy5 = dpos5.Y - (d5.Size.Y.Offset / 2)
    d5.Position = UDim2.new(0, ox5, 0, oy5)

    local d6 = dots[6]
    local rt6 = 6 / 7
    local dpos6 = startPos + (df * rt6)
    local ox6 = dpos6.X - (d6.Size.X.Offset / 2)
    local oy6 = dpos6.Y - (d6.Size.Y.Offset / 2)
    d6.Position = UDim2.new(0, ox6, 0, oy6)

    local dist = df.Magnitude
    local dir = Vector2.new(0, 0)
    if dist > 0 then
        dir = df.Unit
    end

    local intens = dist / 40
    local clampIntens = math.clamp(intens, 0, 1)

    local vecX = dir.X * clampIntens
    local vecY = 0
    local vecZ = dir.Y * clampIntens

    local finalVec = Vector3.new(vecX, vecY, vecZ)
    moveVec = finalVec
end

