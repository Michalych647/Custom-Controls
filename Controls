local ControlModule = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"):WaitForChild("ControlModule")
local VehicleController = require(ControlModule:WaitForChild("VehicleController"))
local originalUpdate = VehicleController.Update
local isHooked = false
local activeVehicleSeat = nil

local function hookVehicleController()
    if isHooked then
        return
    end
    isHooked = true
    VehicleController.Update = function(self, p31, p32, p33)
        local mv, iv = originalUpdate(self, p31, p32, p33)
        local vs = self.vehicleSeat
        if vs then
            activeVehicleSeat = vs
            local thr = 0
            local mz = moveVec.Z
            if mz < -0.1 then
                thr = 1
            elseif mz > 0.1 then
                thr = -1
            end

            local mx = moveVec.X
            local str = math.clamp(mx, -1, 1)

            vs.ThrottleFloat = thr
            vs.SteerFloat = str
        end
        return mv, iv
    end
end

local function unhookVehicleController()
    if not isHooked then
        return
    end
    isHooked = false
    VehicleController.Update = originalUpdate
    local vs = activeVehicleSeat
    if vs then
        vs.ThrottleFloat = 0
        vs.SteerFloat = 0
        activeVehicleSeat = nil
    end
end

local function setupCharacter(c)
    clearConns()
    lastGrounded = 0
    lastJumpPress = 0
    lastJumpReq = 0
    isSwim = false

    local hum = c:WaitForChild("Humanoid", 5)
    if not hum then
        return
    end

    local seatConn = hum:GetPropertyChangedSignal("Sit"):Connect(function()
        local h = getHum()
        if not h then
            return
        end
        local isSit = h.Sit
        if isSit then
            hookVehicleController()
        else
            unhookVehicleController()
        end
    end)
    table.insert(charConns, seatConn)

    local initialSit = hum.Sit
    if initialSit then
        hookVehicleController()
    end

    local function handleLand()
        local diff = tick() - lastJumpPress
        if diff <= bufferTime then
            lastJumpPress = 0
            task.defer(function()
                if hum then
                    local hs = hum:GetState()
                    local hj = Enum.HumanoidStateType.Jumping
                    if hs ~= hj then
                        lastJumpReq = tick()
                        hum:ChangeState(hj)
                    end
                end
            end)
        end
    end

    local stateConn = hum.StateChanged:Connect(function(old, new)
        local sw = Enum.HumanoidStateType.Swimming
        if new == sw then
            isSwim = true
        else
            isSwim = false
        end

        local ff = Enum.HumanoidStateType.Freefall
        if new == ff then
            local tDiff = tick() - lastJumpReq
            if tDiff > 0.25 then
                lastGrounded = tick()
            end
        end

        local ld = Enum.HumanoidStateType.Landed
        if new == ld then
            handleLand()
        end

        local rn = Enum.HumanoidStateType.Running
        if new == rn then
            handleLand()
        end

        local rnp = Enum.HumanoidStateType.RunningNoPhysics
        if new == rnp then
            handleLand()
        end
    end)
    table.insert(charConns, stateConn)

    local floorConn = hum:GetPropertyChangedSignal("FloorMaterial"):Connect(function()
        local fm = hum.FloorMaterial
        local am = Enum.Material.Air
        if fm == am then
            local tDiff2 = tick() - lastJumpReq
            if tDiff2 > 0.25 then
                lastGrounded = tick()
            end
        else
            handleLand()
        end
    end)
    table.insert(charConns, floorConn)
end

